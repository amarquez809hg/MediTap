DEBUG=True
SECRET_KEY=dev-secret
DATABASE_URL=postgres://meditap_user:meditap_pass@db:5432/meditap
ALLOWED_HOSTS=*

# Django group name for staff who may edit patient intake (Admin → Groups; assign users).
MEDITAP_RECORD_EDITOR_ROLE=meditap-record-editor

# Registration: any number of users; default is min-length + match only (no Django strength checks).
# MEDITAP_REGISTER_MIN_PASSWORD_LENGTH=8
# MEDITAP_REGISTER_SKIP_PASSWORD_VALIDATORS=0   # set to 0 to enable full Django password validators

# Optional (DEBUG only): first boot superuser after wipe_users — then remove these lines.
# python manage.py bootstrap_meditap_access
# MEDITAP_BOOTSTRAP_SUPERUSER_USERNAME=admin
# MEDITAP_BOOTSTRAP_SUPERUSER_PASSWORD=change-me-immediately
# MEDITAP_BOOTSTRAP_SUPERUSER_EMAIL=admin@localhost

# --- Epic FHIR sandbox (optional): set EPIC_INTEGRATION_ENABLED=1 and fill URLs from fhir.epic.com ---
# EPIC_INTEGRATION_ENABLED=1
# EPIC_SANDBOX=true
# EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
# EPIC_AUTHORIZE_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/authorize
# EPIC_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token
# EPIC_CLIENT_ID=your-nonprod-client-id
# EPIC_CLIENT_SECRET=   # omit for public clients; many Epic apps are confidential
# EPIC_REDIRECT_URI=http://localhost:8100/epic-callback
# EPIC_DEFAULT_SCOPE=openid fhirUser patient/Patient.read patient/Observation.read

# Email (dev: prints to console; prod: SMTP)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@meditap.ai
# MEDITAP_SUPPORT_INBOX=support@meditap.ai
# MEDITAP_FRONTEND_URL=https://meditap.ai
