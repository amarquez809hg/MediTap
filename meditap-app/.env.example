# Django API (docker-compose: frontend :8100 → backend :8080 on same host)
# VITE_API_BASE=http://localhost:8080

# Capacitor iOS/Android: WebView origin is not your API. Defaults: iOS → http://localhost:8080,
# Android emulator → http://10.0.2.2:8080. Django must allow CORS for capacitor://localhost (repo does).
# Override if needed:
# VITE_API_BASE=http://192.168.1.10:8080
# VITE_NATIVE_API_BASE=http://192.168.1.10:8080

# Optional: editor group name (default meditap-record-editor)
# VITE_MEDITAP_RECORD_EDITOR_ROLE=meditap-record-editor

# Optional: Ionic path after sign-in (default /tab3)
# VITE_POST_LOGIN_PATH=/tab3
